unlocks = Array[ExtResource("s_unlock")]([SubResource("unlock_ivory"), SubResource("unlock_sandstone"), SubResource("unlock_indigo"), SubResource("unlock_madder"), SubResource("unlock_saffron"), SubResource("unlock_marigold"), SubResource("unlock_peacock_teal"), SubResource("unlock_rose"), SubResource("unlock_emerald"), SubResource("unlock_lapis"), SubResource("unlock_copper"), SubResource("unlock_glow"), SubResource("unlock_stripes"), SubResource("unlock_block_print"), SubResource("unlock_lotus"), SubResource("unlock_sun"), SubResource("unlock_jharokha"), SubResource("unlock_peacock"), SubResource("unlock_chakra"), SubResource("unlock_team"), SubResource("unlock_light_racer"), SubResource("unlock_heavy_hauler"), SubResource("unlock_freestyle"), SubResource("unlock_grip_props"), SubResource("unlock_speed_props"), SubResource("unlock_quiet_props"), SubResource("unlock_long_battery"), SubResource("unlock_light_battery")])
