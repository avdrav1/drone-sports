[gd_resource type="Resource" script_class="Part" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/progression/part.gd" id="1_part"]
[ext_resource type="Script" path="res://scripts/story/stat_step.gd" id="2_step"]

[sub_resource type="Resource" id="step_0"]
script = ExtResource("2_step")
stat = &"yaw_torque_per_thrust"
step = 0.02
unit = "yaw torque"

[sub_resource type="Resource" id="step_2"]
script = ExtResource("2_step")
stat = &"battery_flight_time"
step = -30.0
unit = "s flight time"

[resource]
script = ExtResource("1_part")
id = &"freestyle"
kind = &"frame"
name = "Freestyle"
blurb = "Balanced, quick to yaw, a little thirsty."
stats = Array[ExtResource("2_step")]([SubResource("step_0"), SubResource("step_2")])
hull = Vector3(1.0, 1.15, 0.9)
