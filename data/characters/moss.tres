[gd_resource type="Resource" script_class="Character" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/story/character.gd" id="1_char"]
[ext_resource type="Script" path="res://scripts/story/pilot_edge.gd" id="2_edge"]
[ext_resource type="Script" path="res://scripts/story/stat_step.gd" id="3_step"]
[ext_resource type="Script" path="res://scripts/story/assist_setting.gd" id="4_setting"]
[ext_resource type="Resource" path="res://data/crew/looks/moss.tres" id="9_look"]

[sub_resource type="Resource" id="step_0"]
script = ExtResource("3_step")
stat = &"drag"
step = -0.04
unit = "drag"

[sub_resource type="Resource" id="setting_0"]
script = ExtResource("4_setting")
assist = &"auto_level"
property = &"max_angle"
value = 45.0
degrees = true
words = "Leans {value}° while auto-level is on, others {others}"

[sub_resource type="Resource" id="setting_1"]
script = ExtResource("4_setting")
assist = &"brake"
property = &"max_yaw_rate"
value = 130.0
degrees = true
words = "Turns {value}°/s while the brake is on, others {others}"

[sub_resource type="Resource" id="edge"]
script = ExtResource("2_edge")
name = "Clean lines"
best_at = "cornering"
stats = Array[ExtResource("3_step")]([SubResource("step_0")])
assists = Array[ExtResource("4_setting")]([SubResource("setting_0"), SubResource("setting_1")])

[resource]
script = ExtResource("1_char")
id = &"moss"
name = "Moss"
role = "Glide pilot"
look = ExtResource("9_look")
shape = &"fin"
colors = PackedColorArray(0.6, 0.62, 0.3, 1, 0.98, 0.85, 0.7, 1, 0.25, 0.55, 0.6, 1)
lines = "res://data/dialogue/moss.json"
calls_you = PackedStringArray("friend", "feather")
chirp_pitch = 0.75
babble_pitch = 0.75
babble_rate = 6.0
babble_vowels = PackedStringArray("oo", "ah")
bounce = Vector2(0.6,0.39)
death_consequence = &""
can_be_harmed = false
tags = Array[StringName]([&"pilot"])
edge = SubResource("edge")
