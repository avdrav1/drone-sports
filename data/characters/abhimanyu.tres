[gd_resource type="Resource" script_class="Character" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/story/character.gd" id="1_char"]
[ext_resource type="Script" path="res://scripts/story/pilot_edge.gd" id="2_edge"]
[ext_resource type="Script" path="res://scripts/story/stat_step.gd" id="3_step"]
[ext_resource type="Script" path="res://scripts/story/assist_setting.gd" id="4_setting"]
[ext_resource type="Resource" path="res://data/crew/looks/abhimanyu.tres" id="9_look"]
[ext_resource type="Resource" path="res://data/garage/kits/lion_cub.tres" id="10_kit"]

[sub_resource type="Resource" id="step_0"]
script = ExtResource("3_step")
stat = &"max_thrust"
step = 0.5
unit = "N max thrust per motor"

[sub_resource type="Resource" id="setting_0"]
script = ExtResource("4_setting")
assist = &"speed_governor"
property = &"max_speed"
value = 15.0
words = "Top speed {value} m/s while the governor is on, others {others}"

[sub_resource type="Resource" id="setting_1"]
script = ExtResource("4_setting")
assist = &"brake"
property = &"max_speed"
value = 10.0
words = "Stick speed {value} m/s while the brake is on, others {others}"

[sub_resource type="Resource" id="edge"]
script = ExtResource("2_edge")
name = "Hard launch"
best_at = "straight-line speed"
stats = Array[ExtResource("3_step")]([SubResource("step_0")])
assists = Array[ExtResource("4_setting")]([SubResource("setting_0"), SubResource("setting_1")])

[resource]
script = ExtResource("1_char")
id = &"abhimanyu"
name = "Abhimanyu"
role = "Sprint pilot"
named_for = "Named for the young warrior who charged straight in"
look = ExtResource("9_look")
shape = &"visor"
colors = PackedColorArray(0.95, 0.5, 0.55, 1, 1, 0.94, 0.92, 1, 0.18, 0.22, 0.38, 1)
lines = "res://data/dialogue/abhimanyu.json"
calls_you = PackedStringArray("speedy", "racer")
chirp_pitch = 1.3333333
babble_pitch = 1.3333333
babble_rate = 12.5
babble_vowels = PackedStringArray("ah", "ee")
bounce = Vector2(0.9,0.71)
death_consequence = &""
can_be_harmed = false
tags = Array[StringName]([&"pilot"])
edge = SubResource("edge")
body_kit = ExtResource("10_kit")
