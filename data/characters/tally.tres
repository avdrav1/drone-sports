[gd_resource type="Resource" script_class="Character" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/story/character.gd" id="1_char"]
[ext_resource type="Script" path="res://scripts/story/pilot_edge.gd" id="2_edge"]
[ext_resource type="Script" path="res://scripts/story/stat_step.gd" id="3_step"]
[ext_resource type="Script" path="res://scripts/story/assist_setting.gd" id="4_setting"]
[ext_resource type="Resource" path="res://data/crew/looks/tally.tres" id="9_look"]

[sub_resource type="Resource" id="step_0"]
script = ExtResource("3_step")
stat = &"battery_flight_time"
step = 60.0
unit = "s flight time"

[sub_resource type="Resource" id="setting_0"]
script = ExtResource("4_setting")
assist = &"altitude_hold"
property = &"climb_rate"
value = 7.0
words = "Climbs {value} m/s while altitude hold is on, others {others}"

[sub_resource type="Resource" id="setting_1"]
script = ExtResource("4_setting")
assist = &"altitude_hold"
property = &"height_gain"
value = 3.0
words = "Height lock gain {value}, others {others}"

[sub_resource type="Resource" id="setting_2"]
script = ExtResource("4_setting")
assist = &"collision_guard"
property = &"brake_accel"
value = 8.0
words = "Collision guard brakes harder: {value} m/s², others {others}"

[sub_resource type="Resource" id="edge"]
script = ExtResource("2_edge")
name = "Easy on the cells"
best_at = "climbing and endurance"
stats = Array[ExtResource("3_step")]([SubResource("step_0")])
assists = Array[ExtResource("4_setting")]([SubResource("setting_0"), SubResource("setting_1"), SubResource("setting_2")])

[resource]
script = ExtResource("1_char")
id = &"tally"
name = "Hanuman"
role = "Long-haul pilot"
named_for = "Named for the one who leapt the ocean to Lanka"
look = ExtResource("9_look")
shape = &"tuft"
colors = PackedColorArray(0.45, 0.82, 0.6, 1, 0.95, 0.93, 0.82, 1, 0.2, 0.32, 0.3, 1)
lines = "res://data/dialogue/tally.json"
calls_you = PackedStringArray("pal", "partner")
chirp_pitch = 1.125
babble_pitch = 1.125
babble_rate = 9.0
babble_vowels = PackedStringArray("ee", "oo")
bounce = Vector2(0.8,0.92)
death_consequence = &""
can_be_harmed = false
tags = Array[StringName]([&"pilot"])
edge = SubResource("edge")
