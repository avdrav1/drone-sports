[gd_resource type="Resource" script_class="Job" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/jobs/job.gd" id="1_job"]
[ext_resource type="Resource" path="res://data/assists/mission.tres" id="2_assists"]
[ext_resource type="Resource" path="res://data/vows/keeping.tres" id="9_keeping"]
[ext_resource type="Resource" path="res://data/vows/letting_go.tres" id="10_letting_go"]

[resource]
script = ExtResource("1_job")
id = &"inspection"
title = "Relay tower inspection"
summary = "Hover steady at each marked spot on the relay tower so the crew can check it."
scene = "res://scenes/jobs/inspection.tscn"
client = "Meridian Grid"
job_type = &"inspection"
faction = &"city"
required_assists = ExtResource("2_assists")
act = 2
time_limit = 120.0
pay = 650
countdown = 3.0
default_view = 2
crew_in_field = Array[StringName]([&"sanjaya"])
vows = Array[Resource]([ExtResource("9_keeping"), ExtResource("10_letting_go")])
tags = Array[StringName]([&"open"])
weights = {
"Hold1": 1.0,
"Hold2": 1.0,
"Hold3": 1.0,
"NoContact": 2.0,
"UnderTime": 1.0
}
