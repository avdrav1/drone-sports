# Godot
.godot/
*.import
# Material library textures keep their import settings (VRAM compressed, mipmaps)
!data/materials/*.import
# Street clutter model textures too (Story 15.9)
!data/models/*/*.import
# The radio's pixel font keeps its crisp settings (Story 18.12)
!data/ui/fonts/PixelOperatorMono*.import
# The title's font too (Story 24.6)
!data/ui/fonts/YatraOne*.import
build/
export_presets.cfg.bak

