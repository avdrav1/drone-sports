; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="Drone Sports"
run/main_scene="res://scenes/story/intro.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Wallet="*res://scripts/economy/wallet.gd"
Reputation="*res://scripts/economy/reputation.gd"
Roster="*res://scripts/story/roster.gd"
Career="*res://scripts/progression/career.gd"
Garage="*res://scripts/progression/garage.gd"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"

